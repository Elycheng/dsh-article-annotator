{
  "name": "dsh-article-annotator",
  "version": "0.2.0",
  "description": "Text-range annotations (sentence, phrase or any selected words) for Markdown / Word / PowerPoint / PDF articles in DSH's right sidebar, with an agent review loop and a long-term writing-style memory.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/*.js",
    "lib/**/*.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.2",
    "node": ">=20"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "article",
    "annotations",
    "review",
    "sentence",
    "markdown",
    "docx",
    "pptx",
    "pdf",
    "writing-style",
    "selection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elycheng/dsh-article-annotator.git"
  },
  "homepage": "https://github.com/Elycheng/dsh-article-annotator#readme",
  "bugs": {
    "url": "https://github.com/Elycheng/dsh-article-annotator/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node test/run-all.mjs",
    "check:privacy": "node scripts/privacy-scan.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "jsdom": "^29.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.9.0"
  }
}
